# SmartHireAI backend local environment
# Copy this file to .env and replace development values as needed.
# Never commit your real .env file or production secrets.

PROJECT_NAME=SmartHireAI Placement Intelligence Platform
VERSION=1.0.0
API_V1_STR=/api/v1
RUN_MIGRATIONS_ON_STARTUP=true

# Required: replace with a fresh random value before running the API.
SECRET_KEY=replace-this-with-a-unique-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Local PostgreSQL defaults match backend/docker/docker-compose.yml.
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smarthireai
POSTGRES_PORT=5432

# Local Redis; Celery uses Redis as its broker/result backend.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional integrations
GEMINI_API_KEY=

# Use a JSON array. For a hosted frontend, add its exact origin.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
