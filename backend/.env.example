# Required: generate a unique, strong secret for each environment.
SECRET_KEY=

# PostgreSQL connection settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=smarthireai
POSTGRES_SSL=false

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Optional AI integration
GEMINI_API_KEY=

# Optional object storage configuration
AWS_S3_BUCKET=smarthireai-resumes
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
