# Backend API base URL used by the browser-side frontend.
# This value is public, not a secret.
VITE_API_URL="http://127.0.0.1:8000/api/v1"

# Optional: Gemini API key for server-side routes and services only.
# Configure this in your private server environment, never as VITE_GEMINI_API_KEY.
GEMINI_API_KEY=""

# Optional: application URL, only if required by the server-side integration.
APP_URL="http://localhost:5173"
